{
    "localHost": {
        "hostName": "<localhost>",
        "userHome": "/home/<user>",
        "userName": "<user>"
    },
    "knownHosts": "/home/<user>/.ssh/known_hosts",
    "logDir": "/home/<user>/cattleServer-Logs",
    "hostKeyPolicy": "accept-new",
    "apps": [
        {
            "appConfig": {
                "name": "Example",
                "structure": "/loads"
            },
            "databaseConfig": {
                "name": "postgres",
                "structure": "yesod-project"
            },
            "serviceConfig": {
                "backupFrequency": {
                    "times": 8,
                    "unit": "Hours"
                },
                "deleteFrequency": {
                    "times": 10,
                    "unit": "Days"
                },
                "keyDirectory": {
                    "name": "exampleKey-ed25519",
                    "structure": "/home/<user>/.ssh"
                },
                "portNumber": 22,
                "remoteHost": {
                    "hostName": "0.0.0.0",
                    "userHome": "/home/<remote-user>",
                    "userName": "<remote-user>"
                },
                "hostKeyFingerprint": "SHA256:<base64 fingerprint>"
            }
        },
        {
            "appConfig": {
                "name": "Example 2",
                "structure": "/loads"
            },
            "databaseConfig": {
                "name": "postgres",
                "structure": "yesod-project"
            },
            "serviceConfig": {
                "backupFrequency": {
                    "times": 10,
                    "unit": "Days"
                },
                "deleteFrequency": {
                    "times": 2,
                    "unit": "Months"
                },
                "keyDirectory": {
                    "name": "exampleKey-ed25519",
                    "structure": "/home/<user>/.ssh"
                },
                "portNumber": 2222,
                "remoteHost": {
                    "hostName": "0.0.0.0",
                    "userHome": "/home/<remote-user>",
                    "userName": "<remote-user>"
                },
                "hostKeys": [
                    "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI<base64 key>"
                ]
            }
        }
    ]
}
